{
  "version": 5,
  "changelog": [
    {
      "version": 5,
      "date": "2026-08-03",
      "title": "Tracking accuracy improvements",
      "body": "- Rep thresholds no longer get poisoned by a glitchy first attempt\n- Handstand holds stop immediately when your feet touch the floor\n- Wall sit pauses when the squat position is lost\n- Squats require a meaningful parallel-depth bend\n- Jump squat and HSPU lockout zones are easier to reach\n- Pistol squat now uses a front view to track both legs\n- Superman hold requires a real limb lift\n- Mountain climbers accept a natural plank return"
    },
    {
      "version": 1,
      "date": "2026-07-29",
      "title": "Counting thresholds relaxed across all exercises",
      "body": "Rep counting is now more forgiving — you don't need to hit absolute full range for a rep to register. Form cues still nudge you toward full range. Every exercise got more breathing room."
    }
  ],
