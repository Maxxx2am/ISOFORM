{
  "version": 3,
  "changelog": [
    {
      "version": 3,
      "date": "2026-07-30",
      "title": "Rep gauge green zones expanded to 25%, faster launch, collapsible insights",
      "body": "- Rep gauge: green zone expanded from 20% to 25% at both ends (depth + lockout) — easier to stay in the green\n- Launch: assets now load after first screen renders, so the app opens faster\n- Insights: achievements & muscle focus sections are now collapsible (show 4 + \"more\" button)\n- Buttons: spring-animated press effect on every primary action button"
    },
    {
      "version": 2,
      "date": "2026-07-29",
      "title": "Counting thresholds relaxed",
      "body": "- Squat: less depth + less lockout needed to count a rep\n- Push-up: don't need chest-to-floor or full arm lockout\n- Pull-up: more forgiving at both bottom and top\n- Dip: easier depth and lockout thresholds\n- Jump squat: small hop counts now, no need to jump high\n- Pistol squat: wider range, less strict on depth and lockout\n- HSPU: relaxed elbow thresholds at both ends\n- L-Sit → V raises: wider hip window\n- All planche/front-lever holds: more forgiving minimum angles\n- Wall sit / Superman hold: wider hold window\n- Leg raise / Hanging knee raise: relaxed range\n- Jumping jacks / Mountain climbers: more breathing room"
    },
    {
      "version": 1,
      "date": "2026-07-29",
      "title": "Counting thresholds relaxed across all exercises",
      "body": "Rep counting is now more forgiving — you don't need to hit absolute full range for a rep to register. Form cues still nudge you toward full range. Every exercise got more breathing room."
    }
  ],
