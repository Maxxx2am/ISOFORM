{
  "expo": {
    "name": "ISOFORM",
    "slug": "iso-form",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isoform",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maxxxdev.isoform",
      "buildNumber": "25",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "ISOFORM uses the camera to track your body and check your exercise form on-device. Nothing leaves your phone.",
        "NSMicrophoneUsageDescription": "ISOFORM records your set so you can replay it with form feedback. Audio stays on your phone.",
        "NSLocationWhenInUseUsageDescription": "ISOFORM does not track your location. This is only here because a library references it — no location data is ever collected.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.maxxxdev.isoform",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-audio",
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ISOFORM uses the camera to track your body and check your exercise form on-device. Nothing leaves your phone.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "ISOFORM records your set so you can replay it with form feedback. Audio stays on your phone."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": [
            "./assets/models/"
          ],
          "ignoredPattern": "\\.(md|tflite)$"
        }
      ]
    ],
    "experiments": {},
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de241edb-7de6-4cef-b782-3b042b4feedd"
      }
    },
    "owner": "lylavirell",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/de241edb-7de6-4cef-b782-3b042b4feedd"
    }
  }
}
